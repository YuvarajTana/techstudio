APP_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=teckstudio

JWT_SECRET=replace-with-a-strong-local-secret-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_EXPIRY_DAYS=7

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_CHAT_MODEL=gpt-4o-mini
AI_CHAT_PROVIDER_PRIORITY=gemini,openai,pollinations

STABILITY_API_KEY=
AI_PROVIDER_PRIORITY=openai,gemini,pollinations
IMAGE_PROVIDER_ORDER=openai,gemini,pollinations
AI_IMAGE_TIMEOUT_SECONDS=60
AI_IMAGE_MAX_RETRIES=2
ENABLE_POLLINATIONS_FALLBACK=true
ENABLE_FAKE_AI_FALLBACK=false

# Connected asset providers
ICONIFY_API_KEY=
UNSPLASH_ACCESS_KEY=
LOTTIEFILES_API_KEY=
LOTTIEFILES_API_URL=https://api.lottiefiles.com/v2/animations

# Background video rendering
FFMPEG_BINARY=ffmpeg
VIDEO_RENDER_RETENTION_HOURS=24
VIDEO_RENDER_TIMEOUT_SECONDS=900
MAX_VIDEO_RENDER_SCENES=100

# Lesson Video / Remotion (local worker)
# Default output root is the repository's .local/video-artifacts directory.
# LESSON_VIDEO_ROOT=/absolute/path/to/lesson-video-artifacts
LESSON_VIDEO_LEASE_SECONDS=60
LESSON_VIDEO_MAX_ATTEMPTS=2
# Blank uses the private .local/video-worker.key generated by npm run video:prepare.
# If overridden, also set this value in the Node worker's process environment.
LESSON_VIDEO_WORKER_SECRET=

HOST=0.0.0.0
PORT=5001
